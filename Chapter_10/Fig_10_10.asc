TEXT -344 672 Left 2 !.save V(out) I(I1)\n.option numdgt=15   ; double precision for data\n.option nomarch       ; do not plot marching waveforms
TEXT -344 768 Left 2 !.measure Aavg              avg       V(out)                                                                ; average output voltage\n.measure Bavg              avg       -I(I1)                                                                   ; average output current\n.measure Are                  avg       2*(V(out)-Aavg)*cos(360*Freq*time)      ; A real part\n.measure Aim                 avg       2*(V(out)-Aavg)*sin(360*Freq*time)        ; A imag part\n.measure Bre                  avg       2*(-I(I1)-Bavg)*cos(360*Freq*time)         ; B real part\n.measure Bim                 avg        2*(-I(I1)-Bavg)*sin(360*Freq*time)          ; B imag part\n.measure Amag             param   hypot(Are,Aim)                                              ; A magnitude\n.measure Bmag             param   hypot(Bre,Bim)                                              ; B magnitude\n.measure Aphi                param   atan2(Aim, Are)                                             ; A phase\n.measure Bphi                param   atan2(Bim, Bre)                                             ; B phase\n.measure GainMag       param    20*log10(Amag/Bmag)                             ; Gain magnitude\n.measure GainPhi          param    Bphi - Aphi                                                     ; Gain phase
