TEXT 48 384 Left 2 !.save V(b) I(V1)\n.option numdgt=15   ; double precision for data\n.option nomarch       ; do not plot marching waveforms
TEXT -360 520 Left 2 !.measure Aavg              avg       V(b)                                                          ; average input voltage\n.measure Bavg              avg       -I(V1)                                                        ; average input current\n.measure Are                  avg       2*(V(b)-Aavg)*cos(360*Freq*time)      ; A real part\n.measure Aim                 avg       2*(V(b)-Aavg)*sin(360*Freq*time)        ; A imag part\n.measure Bre                  avg       2*(-I(V1)-Bavg)*cos(360*Freq*time)         ; B real part\n.measure Bim                 avg        2*(-I(V1)-Bavg)*sin(360*Freq*time)          ; B imag part\n.measure Amag             param   hypot(Are,Aim)                                              ; A magnitude\n.measure Bmag             param   hypot(Bre,Bim)                                              ; B magnitude\n.measure Aphi                param   atan2(Aim, Are)                                             ; A phase\n.measure Bphi                param   atan2(Bim, Bre)                                             ; B phase\n.measure GainMag       param    20*log10(Amag/Bmag)                             ; Gain magnitude\n.measure GainPhi          param    Bphi - Aphi                                                     ; Gain phase
